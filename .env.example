# Single source of truth for which Midnight network the project talks to and
# where its contracts are deployed there. Read by:
#   - back/contracts/src/network.ts (resolveNetwork) and deploy-address.ts
#   - front/ (via vite.config.ts's envDir + envPrefix — see front/src/midnight/network.ts)
#
# Copy this file to .env and adjust. .env is gitignored; this template is not.

# One of: undeployed | preview | preprod. Change this line to move both the
# back/contracts scripts and the frontend to a different network — nothing
# else needs editing.
MIDNIGHT_NETWORK=undeployed

# Contract addresses, one deployment per network switch above. Not written by
# any script — copied here by hand after each `deploy:address` run (see
# back/contracts/src/deploy-address.ts), so they never silently go stale
# relative to what deploy:address printed. Leave blank until deployed on the
# active network — front/src/midnight/network.ts's getContractAddress()
# throws a clear error if a circuit call needs one that isn't set.
VINCHI_NOTES_ADDRESS=
MERCHANT_REGISTRY_ADDRESS=

# Secret. Only used locally by `npm run register-dust` (back/contracts/src/
# register-dust.ts) to register an arbitrary wallet's NIGHT for DUST
# generation on `undeployed` — e.g. a Lace wallet, whose own "Generate DUST"
# UI is built around Preprod's public infra and doesn't work against the
# local network. Paste the 24-word recovery phrase from that wallet (Lace:
# wallet settings > reveal recovery phrase). Does NOT reach the frontend
# bundle: vite.config.ts's envPrefix only allowlists MIDNIGHT_NETWORK,
# VINCHI_NOTES_ADDRESS and MERCHANT_REGISTRY_ADDRESS by exact name, and this
# doesn't match any of them. Leave blank when not actively registering DUST.
MIDNIGHT_WALLET_MNEMONIC=

# Secret. governor's real secret key — see back/contracts/src/governor.ts /
# generate-governor.ts (run once to create one). Required by
# deploy-address.ts (computes governorPk = governorKey(this) for the
# constructor) and by any governor-gated action (addMerchant,
# syncMerchantRoot, pokeIndex). governor is `sealed` in the .compact source
# (fixed forever at construction) — deploying without a real key here
# permanently locks out every governor-gated circuit on that deployment.
GOVERNOR_SECRET_KEY=

# Off-chain note-backup store (see front/src/midnight/noteBackup.ts). Public
# by design: RLS-gated, and rows only ever hold owner_tag (a private lookup
# key derived from the wallet seed, NOT the on-chain ownerCommitment) plus
# AES-GCM ciphertext encrypted client-side — Supabase never sees plaintext
# amounts, maturity dates, or anything linkable to on-chain identity.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
